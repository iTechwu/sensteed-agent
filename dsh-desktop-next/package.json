  "exports": {
    ".": "./lib/extensions.js",
    "./client": "./lib/client.js",
    "./extensions": "./lib/extensions.js",
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./lib/permissions.js"
    },
    "./package.json": "./package.json",
    "./webserver": "./lib/webserver.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "optionalBundles": [
      "dsh-community-market",
      "dshmarket",
      "@agents-anywhere/dsh-bridge-next"
    ],
    "exclusiveBundles": [
      [
        "dsh-community-market",
        "dshmarket"
      ]
    ]
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop.next",
    "productName": "DSH NEXT",
    "asar": true,
    "beforeBuild": "./scripts/before-build.ts",
    "beforePack": "./scripts/prepare-pack.ts",
    "afterPack": "./scripts/verify-packaged.ts",
    "afterAllArtifactBuild": "./scripts/verify-fuses.ts",
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": false,
      "resetAdHocDarwinSignature": true,
      "runAsNode": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "files": [
      {
        "from": ".desktop-build/payload",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".desktop-build/payload/node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "artifactName": "DSH-NEXT-${version}-${arch}.${ext}",
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh_CN"
        ],
        "NSMicrophoneUsageDescription": "DSH NEXT uses the microphone when you enable a feature that records audio.",
        "NSAudioCaptureUsageDescription": "DSH NEXT captures screen audio when you request it.",
        "NSLocalNetworkUsageDescription": "DSH NEXT connects to devices on your local network when you enable network access.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "hardenedRuntime": true,
      "entitlements": "../deepseek-harness/apps/desktop/scripts/macos-entitlements.plist",
      "entitlementsInherit": "../deepseek-harness/apps/desktop/scripts/macos-entitlements.plist",
      "icon": "build/app-icon.icon",
      "extraResources": [
        {
          "from": ".desktop-build/runtime",
          "to": "runtime"
        },
        {
          "from": ".desktop-build/payload/package.json",
          "to": "app/package.json"
        }
      ],
      "mergeASARs": false,
      "notarize": true,
      "signIgnore": [
        "\\.(?:pak|dat|wasm)$",
        "/Contents/Resources/runtime/(?:arm64|x64)/primary-runtime(?:/|$)"
      ],
      "x64ArchFiles": "{**/node_modules/{@deepseek-ai/node-addon-system-darwin-*/**,node-pty/prebuilds/darwin-*/**,fs-ext/prebuilds/darwin-*/**,node-addon-require-builtin-darwin-*/**,@vscode/ripgrep-darwin-*/**,@img/sharp-darwin-*/**,@img/sharp-libvips-darwin-*/**,@koromix/koffi-darwin-*/**,@dataiku/uv-darwin-*/**,@deepseek-ai/libreoffice-kit-darwin-*/**,sherpa-onnx-darwin-*/**,@trycua/cua-driver-darwin-*/**,@ubjs/node-darwin-*/**,@reflink/reflink-darwin-*/**},Contents/Resources/runtime/**,Contents/Resources/runtime/**/.*/**}"
    },
    "win": {
      "compression": "normal",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DSH-NEXT-${version}-${arch}-Portable.${ext}",
      "icon": "build/app-icon.ico",
      "extraResources": [
        {
          "from": ".desktop-build/runtime",
          "to": "runtime"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false,
      "shortcutName": "DSH NEXT",
      "useZip": false,
      "artifactName": "DSH-NEXT-${version}-${arch}-Setup.${ext}",
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico",
      "include": "../dsh-plugin-desktop/build/installer.nsh"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/app-icon.png"
    },
    "dmg": {
      "icon": "build/app-icon.icns"
    },
    "asarUnpack": [
      "**/*.{node,dylib,dll,so,exe}",
      "**/*.so.*",
      "**/spawn-helper",
      "**/@vscode/ripgrep-*/bin/rg",
      "**/@dataiku/uv-*/bin/uv",
      "**/node_modules/@deepseek-ai/libreoffice-kit-*/**/*",
      "**/node_modules/@trycua/cua-driver-*/**/*",
      "**/node_modules/sherpa-onnx-*/**/*",
      "**/node_modules/@agents-anywhere/dsh-bridge-next/lib/bundled-connector/**/*",
      "**/node_modules/@deepseek-ai/dsh-agent-preset/**/*",
      "**/node_modules/@deepseek-ai/dsh-skill-badge/**/*",
      "**/node_modules/pnpm/**/*",
      ".desktop-build/payload/scripts/node-bin/**/*",
      ".desktop-build/payload/assets/**/*",
      ".desktop-build/payload/build/**/*"
    ]
  }
}
