{
  "name": "dsh-desktop-next",
  "version": "2.0.20-next",
  "private": true,
  "description": "Experimental upstream-inspired DSH Desktop with Profiles, recovery, remote control and Community Market",
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.client.config.ts && vite build --config vite.native-ui.config.ts",
    "typecheck": "node ../scripts/run-parallel.mjs \"tsc --noEmit\" \"tsc -p tsconfig.packaging.json --noEmit\"",
    "test": "vitest run",
    "verify:host": "node scripts/verify-host.mjs && node scripts/verify-enterprise-host.mjs",
    "verify:host:electron": "node scripts/verify-host.mjs --electron",
    "verify:frontend": "node scripts/verify-frontend.mjs",
    "verify:window-controls": "node scripts/verify-window-controls.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:protocol": "electron scripts/verify-protocol.mjs",
    "verify:sidebar-browser": "electron scripts/verify-sidebar-browser.mjs",
    "check": "pnpm run build && node ../scripts/run-parallel.mjs \"pnpm run typecheck\" \"pnpm run test\" \"pnpm run verify:frontend\" \"pnpm run verify:host\" \"pnpm run verify:desktop-runtime\" \"pnpm run verify:safe-cleanup\"",
    "dev": "pnpm run build && pnpm run prepare:runtime && node scripts/start.mjs",
    "start": "pnpm run prepare:runtime && node scripts/start.mjs",
    "verify:desktop-runtime": "node scripts/verify-desktop-runtime.mjs",
    "verify:safe-cleanup": "node scripts/verify-safe-cleanup.mjs",
    "icons:export": "node ../scripts/export-app-icons.mjs --channel next",
    "prepare:runtime": "node scripts/prepare-runtime.ts",
    "package:dir": "pnpm run build && node scripts/package.ts dir",
    "dist:mac": "node scripts/package.ts mac",
    "dist:mac-smoke": "node scripts/package.ts mac-smoke",
    "dist:win": "node scripts/package.ts win",
    "check:mac-package": "pnpm run check",
    "check:win-package": "pnpm run check"
  },
