{
  "name": "@dofe/dsh-sensteed-knowledge",
  "version": "0.2.0",
  "description": "Yootun enterprise knowledge, Memory, and knowledge graph workspace",
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "capabilities": [{"id": "knowledge-memory", "kind": "business", "name": "企业知识与 Memory", "description": "检索企业知识，管理记忆，并维护知识图谱关系。"}],
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "files": ["cordis.patch.yml", "index.js", "lib"],
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test test/*.test.mjs", "check": "npm run build && npm test" },
  "license": "MIT",
  "private": true
}
