{
  "name": "@dofe/dsh-sensteed-finance",
  "version": "0.1.0",
  "description": "Sensteed 财务专业看板：预算/台账/资金/预警/成本 BOM/数据治理/录入工作台 + 深度分析入口（调用财务数据中心 MCP）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [{"id": "finance-management", "kind": "business", "name": "财务经营分析", "description": "预算、台账、资金、预警、成本 BOM 和数据治理看板。"}],
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node --check lib/client.js && npm test"
  },
  "license": "MIT",
  "private": true
}
