{
  "name": "@dofe/dsh-sensteed-finance",
  "version": "0.1.0",
  "description": "Sensteed 财务工作台：预算编制/比较/执行、资金、复核、成本 BOM、数据治理、通知与权限（公开 REST 契约）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [
      {
        "id": "finance-management",
        "kind": "business",
        "group": "business",
        "name": "财务经营分析",
        "description": "分析预算、台账、资金、经营预警与成本 BOM，查看数据治理看板。"
      }
    ],
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib",
    "public-routes.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node --check lib/client.js && npm test",
    "check:datasource": "node scripts/check-datasource-parity.mjs"
  },
  "license": "MIT",
  "private": true
}
