{
  "name": "@dofe/dsh-sensteed-supplier-intelligence",
  "version": "0.1.0",
  "description": "Sensteed supplier collection coverage and public-opinion analysis skill",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [
      {
        "id": "supplier-intelligence",
        "kind": "business",
        "group": "business",
        "name": "供应商情报与风险",
        "description": "查询企业与供应商信息，采集舆情，分析关系与风险变化。"
      }
    ],
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node --check index.js && node --check lib/client.js && npm test"
  },
  "license": "MIT",
  "private": true
}
