{
  "name": "@dofe/dsh-sensteed-skill-manager",
  "version": "0.1.0",
  "description": "Manage local and company-shared Sensteed Agent skills",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "hub-client.js",
    "trusted-release-keys.json",
    "lib",
    "skill-archive.js",
    "hub-release-verifier.js",
    "hub-install-store.js",
    "hub-skill-installer.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node --check src/client.js && node --check lib/client.js && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "yaml": "^2.9.0",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.3",
    "semver": "^7.7.3"
  },
  "license": "MIT",
  "private": true
}
