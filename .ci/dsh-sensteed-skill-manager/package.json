{
  "name": "@dofe/dsh-sensteed-skill-manager",
  "version": "0.1.0",
  "description": "Thin catalog entry for sealed Host Hub generation management",
  "type": "module",
  "main": "./thin/index.js",
  "exports": {
    ".": "./thin/index.js",
    "./client": "./thin/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "thin/index.js",
    "thin/client.js"
  ],
  "scripts": {
    "build": "node --check thin/index.js && node --check thin/client.js",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node --test test/thin-pack.test.mjs"
  },
  "license": "MIT",
  "private": true
}
