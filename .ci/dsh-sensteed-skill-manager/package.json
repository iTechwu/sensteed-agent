{
  "name": "@dofe/dsh-sensteed-skill-manager",
  "version": "0.1.0",
  "description": "Manage local Sensteed Agent skills",
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  },
  "files": ["cordis.patch.yml", "index.js", "lib"],
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test test/*.test.mjs", "check": "npm run build && npm test" },
  "dependencies": { "yaml": "^2.9.0" },
  "license": "MIT",
  "private": true
}
