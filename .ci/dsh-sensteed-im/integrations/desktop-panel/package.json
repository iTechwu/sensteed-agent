{
  "name": "dsh-im-desktop-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent local sensteed-im sidebar integration for Nezha Agent Desktop",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "sensteed-im",
        "dsh-tauri"
      ]
    }
  }
}
