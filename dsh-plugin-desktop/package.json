{
  "name": "dsh-plugin-desktop",
  "version": "2.0.11-beta.21",
  "description": "Yootun-Agent: an Electron shell composed as a DeepSeek Harness Cordis plugin",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "directory": "dsh-plugin-desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "sensteed-agent": "lib/bin.js",
    "dsh-plugin-desktop": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./profile": {
      "types": "./lib/types/profile.d.ts",
      "default": "./lib/profile.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./webserver": {
      "types": "./lib/types/webserver.d.ts",
      "default": "./lib/webserver.js"
    },
    "./windows-pwsh-sandbox": {
      "types": "./lib/types/windows-pwsh-sandbox.d.ts",
      "default": "./lib/windows-pwsh-sandbox.js"
    },
    "./browser-tools": {
      "types": "./lib/types/browser-tools.d.ts",
      "default": "./lib/browser-tools.js"
    },
    "./ci-tools": {
      "types": "./lib/types/ci-tools.d.ts",
      "default": "./lib/ci-tools.js"
    },
    "./terminal": {
      "types": "./lib/types/terminal.d.ts",
      "default": "./lib/terminal.js"
    },
    "./pnpm": {
      "types": "./lib/types/pnpm.d.ts",
      "default": "./lib/pnpm.js"
    },
    "./profile-service": {
      "types": "./lib/types/profile-service.d.ts",
      "default": "./lib/profile-service.js"
    },
    "./desktop-plugins": {
      "types": "./lib/types/desktop-plugins.d.ts",
      "default": "./lib/desktop-plugins.js"
    },
    "./profiles": {
      "types": "./lib/types/profiles.d.ts",
      "default": "./lib/profiles.js"
    },
    "./diagnostics": {
      "types": "./lib/types/diagnostics.d.ts",
      "default": "./lib/diagnostics.js"
    },
    "./notifications": {
      "types": "./lib/types/notifications.d.ts",
      "default": "./lib/notifications.js"
    },
    "./updates": {
      "types": "./lib/types/updates.d.ts",
      "default": "./lib/updates.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/app-icon.ico",
    "build/app-icon.png",
    "build/app-icon-mac.png",
    "build/brand-logo.png",
    "build/hero-brand.png",
    "build/sidebar-brand.png",
    "build/tray-icon*.png",
    "cordis.patch.yml",
    "docs/**",
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/native-ui/**",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "THIRD_PARTY_NOTICES.md",
    "build/app-icon.icon/**",
    "build/app-icon.icns",
    "build/app-icon.resources.json",
    "build/icons/**"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "corepack pnpm run generate:brand && node ../scripts/build-finance-ui.mjs && node scripts/clean.mjs && tsdown && vite build --config vite.native-ui.config.ts && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly && node scripts/generate-profile-closure.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs && node scripts/generate-lockup.ts && node scripts/generate-client-brand-module.mjs && node scripts/generate-product-identity.mjs && node scripts/generate-mac-app-icon.mjs && node scripts/generate-tray-icons.mjs && node scripts/generate-windows-app-icon.mjs",
    "verify:brand": "node scripts/verify-brand-sync.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.native-ui.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.tests.client.json --noEmit",
    "test": "vitest run",
    "test:audit-ui": "node tests/browser/yootun-audit.visual.mjs",
    "test:access-ui": "node tests/browser/yootun-access.browser.mjs",
    "test:deliverables-ui": "node tests/browser/deliverables.visual.mjs",
    "test:plugin-console-ui": "node tests/browser/plugin-console.visual.mjs && node tests/browser/plugin-console-modal.browser.mjs && node tests/browser/plugin-console-management.browser.mjs",
    "test:plugin-surfaces-ui": "node tests/browser/yootun-access.browser.mjs && node tests/browser/deliverables.visual.mjs && node tests/browser/plugin-console.visual.mjs && node tests/browser/plugin-console-modal.browser.mjs && node tests/browser/plugin-console-management.browser.mjs",
    "test:search-locks-ui": "node tests/browser/yootun-search-locks.visual.mjs",
    "test:theme-actions-ui": "node tests/browser/yootun-theme-actions.visual.mjs",
    "verify:closure": "node --test scripts/runtime-closure.spec.mjs && node scripts/verify-runtime-closure.mjs && node scripts/generate-profile-closure.mjs --check",
    "verify:cli": "node scripts/verify-cli-runtime.mjs",
    "verify:loader": "node scripts/verify-loader-boot.mjs",
    "verify:sensteed-clients": "node --test scripts/sensteed-client-runtime.spec.mjs && node scripts/verify-sensteed-client-runtime.mjs",
    "verify:profile": "node scripts/verify-profile-boot.mjs",
    "verify:renderer": "node scripts/verify-profile-boot.mjs --renderer --compatibility && node scripts/verify-profile-boot.mjs --renderer",
    "verify:licenses": "node --test scripts/license-file.spec.mjs && node scripts/verify-licenses.mjs",
    "verify:operations": "node --test scripts/operation-reliability.spec.mjs && node scripts/verify-operation-reliability.mjs",
    "verify:notices": "node scripts/verify-licenses.mjs --notices THIRD_PARTY_NOTICES.md",
    "check": "corepack pnpm run verify:brand && corepack pnpm run build && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run verify:closure && corepack pnpm run verify:cli && corepack pnpm run verify:loader && corepack pnpm run verify:sensteed-clients && corepack pnpm run verify:profile && corepack pnpm run verify:licenses && corepack pnpm run verify:operations",
    "check:win-package": "pnpm --filter @dofe/dsh-sensteed-product build && pnpm --filter dsh-community-market build && pnpm run build && pnpm run typecheck && vitest run tests/client-boot-health.spec.ts tests/renderer-boot.spec.ts tests/renderer-recovery.spec.ts tests/package.spec.ts tests/package-win.spec.ts tests/desktop-installer-quit.spec.ts tests/installer-nsh.spec.ts tests/update-checker.spec.ts tests/update-download.spec.ts tests/verify-win-installer.spec.ts tests/verify-win-portable.spec.ts tests/verify-packaged-runtime.spec.ts tests/windows-pwsh-sandbox.spec.ts tests/windows-volume-diagnostics.spec.ts tests/window-options.spec.ts tests/safe-mode.spec.ts tests/quit-gate.spec.ts tests/desktop-mandatory-policy.spec.ts tests/mandatory-update-dialog.spec.ts && pnpm run verify:closure",
    "check:mac-package": "corepack pnpm --filter @dofe/dsh-sensteed-product build && corepack pnpm --filter dsh-community-market build && corepack pnpm run build && corepack pnpm run typecheck && vitest run tests/package.spec.ts tests/package-mac.spec.ts tests/verify-mac-smoke.spec.ts tests/verify-packaged-runtime.spec.ts tests/mac-universal.spec.ts && corepack pnpm run verify:closure",
    "check:linux-package": "corepack pnpm --filter @dofe/dsh-sensteed-product build && corepack pnpm --filter dsh-community-market build && corepack pnpm run build && corepack pnpm run typecheck && vitest run tests/package.spec.ts tests/package-linux.spec.ts tests/verify-linux-artifacts.spec.ts tests/verify-packaged-runtime.spec.ts && corepack pnpm run verify:closure",
    "start": "node lib/bin.js",
    "dev": "corepack pnpm run build && node lib/bin.js",
    "package:dir": "corepack pnpm run build && node scripts/package-dir.mjs",
    "dist:mac": "node scripts/release-mac.ts",
    "dist:mac-smoke": "node scripts/package-mac.ts",
    "dist:win": "node scripts/package-win.ts",
    "dist:win-portable": "node scripts/package-win-portable.ts",
    "dist:linux": "node scripts/package-linux.ts",
    "prepack": "corepack pnpm run check"
  },
