{
  "name": "@dofe/dsh-sensteed-product",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dofe-auth-contract": "./lib/dofe-auth-contract.js",
    "./dofe-auth-oidc": "./lib/dofe-auth-oidc.js",
    "./dofe-models": "./lib/dofe-models.js",
    "./dofe-plugins": "./lib/dofe-plugins.js",
    "./finance-mcp": "./lib/finance-mcp.js",
    "./knowledge-routing": "./lib/knowledge-routing.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh": ">=0.2.0-rc.0 <1",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.0 <1"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate:brand": "node scripts/generate-brand-module.mjs",
    "verify:brand": "node scripts/verify-brand-sync.mjs && node --test tests/brand-round-trip.spec.mjs",
    "build": "node scripts/generate-brand-module.mjs && node scripts/clean.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "corepack pnpm run verify:brand && corepack pnpm run build && corepack pnpm run typecheck && corepack pnpm run test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@types/node": "^22.20.0",
    "sharp": "0.35.3",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
